# EduCore Backend Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educore_cms?schema=public"

# JWT Authentication
JWT_SECRET="educore-super-secure-jwt-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# Logging & Telemetry
LOG_LEVEL="info"

# Staging & Production External Services (Mail, Storage, SMS)
# SMTP Provider (e.g., Mailtrap, AWS SES, SendGrid)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="staging_sandbox_user"
SMTP_PASS="staging_sandbox_password"
SMTP_FROM="no-reply@educore.edu"

# Document Vault Cloud Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER="local" # Options: "local", "s3"
STORAGE_BUCKET="educore-vault-staging"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="staging_storage_key"
STORAGE_SECRET_KEY="staging_storage_secret"
